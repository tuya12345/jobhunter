# ============================================================================
# JobHunter .gitignore
# ----------------------------------------------------------------------------
# ⚠️ 隐私红线：这个文件是"不泄露个人数据"的第一道防线，改动前请读 docs/data_model.md。
# ⚠️ 最容易漏的是 *.db-wal / *.db-shm —— SQLite 开了 WAL 之后，真实数据会先落在
#    .db-wal 里，只忽略 *.db 等于把真实投递记录提交上去了。
# ============================================================================

# ---- 密钥与本地配置（绝对不能提交）------------------------------------------
.env
.env.*
!.env.example

# ---- 数据库：主库 + WAL 日志 + 共享内存文件 --------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# ---- 运行时数据目录 ---------------------------------------------------------
data/
output/
state/

# ---- 个人文档（简历原文等，绝不入库）----------------------------------------
*.docx
*.pdf
*.doc
*.rtf

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 虚拟环境（uv / venv / poetry 都覆盖）-----------------------------------
.venv/
venv/
env/
ENV/

# ---- 测试与 lint 缓存 -------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 编辑器 / 系统 ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
