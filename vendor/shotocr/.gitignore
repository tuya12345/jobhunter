# ── 虚拟环境 ────────────────────────────────────────────────
# 含 rapidocr + onnxruntime + paddle，约 987 MB，绝对不该入库
.venv/

# ── Python 缓存 ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── 运行输出 ────────────────────────────────────────────────
# 识别结果里可能有截图内容（聊天记录、岗位信息等），不入库
out/

# ── 打包产物 ────────────────────────────────────────────────
build/
dist/

# ── 真实截图：只保留说明文件 ────────────────────────────────
# samples\real\ 放的是用户自己的截图，可能含个人信息。
# 用 "先全排除、再放行 README" 的写法，这样目录本身能被 git 保留。
samples/real/*
!samples/real/README.md

# ── 系统文件 ────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
